# --- required: KIE.ai covers image, video and music generation ---
# Get a key at https://kie.ai
KIE_API_KEY=your-kie-api-key-here

# --- recommended: direct ElevenLabs voice generation ---
# KIE also resells ElevenLabs TTS, but that endpoint has recurring outages;
# the default story routes voice here. Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_MODEL=eleven_v4

# --- model picks (defaults = budget/quality sweet spot, measured 2026-11) ---
# Still images: qwen3/pro-text-to-image (~6.4 credits, 1344x768, refs work)
# Alternatives: z-image (cheapest), nano-banana-pro (premium)
KIE_IMAGE_MODEL=qwen3/pro-text-to-image

# Clip animation: minimax-h3/image-to-video (~48 credits/6s, fast, makes its
# own soundtrack which the studio silences by default)
# Alternatives: hailuo/2-3-image-to-video-pro, bytedance/seedance-2-fast
KIE_VIDEO_MODEL=minimax-h3/image-to-video

# Music bed: Suno version via KIE
KIE_MUSIC_MODEL=V4_5

# --- rarely needed ---
# KIE_BASE_URL=https://api.kie.ai
# FFMPEG=/path/to/ffmpeg        # default: imageio-ffmpeg's bundled binary
# TOON_BACKEND=kie              # default backend when a story doesn't specify
